APP_NAME=campus-ai
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

DEEPSEEK_API_KEY=sk-你自己的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MESSAGE=抱歉，模型服务暂时不可用，请稍后重试
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

DATABASE_URL=postgresql+psycopg://campus:campus_pwd@localhost:5432/campus
REDIS_URL=redis://localhost:6379/0
ANSWER_CACHE_TTL=3600

RATE_LIMIT_PER_MINUTE=20

CORS_ORIGINS=*

