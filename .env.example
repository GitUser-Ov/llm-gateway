APP_NAME=llm-gateway
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

DEEPSEEK_API_KEY=sk-你自己的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
LLM_FALLBACK_MESSAGE=抱歉，模型服务暂时不可用，请稍后重试
LLM_STREAM_USAGE=true

# 多上游网关：JSON 数组，顺序即优先级，第一个是主上游，失败自动切换下一个。
# 留空则回退到上面 DEEPSEEK_* 的单上游配置（向后兼容）。
# 例：
# LLM_UPSTREAMS=[{"name":"deepseek","api_key":"sk-xxx","model":"deepseek-chat"},{"name":"doubao","api_key":"ark-xxx","base_url":"https://ark.cn-beijing.volces.com/api/v3","model":"doubao-xxx"}]
LLM_UPSTREAMS=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

DATABASE_URL=postgresql+psycopg://campus:campus_pwd@localhost:5432/campus
REDIS_URL=redis://localhost:6379/0
ANSWER_CACHE_TTL=3600

RATE_LIMIT_PER_MINUTE=20
DAILY_QUOTA=300

# ---------- RAG（私有知识库检索）----------
RAG_ENABLED=true
# 向量后端：local=本地 sentence-transformers（推荐）| ollama | fake（仅测试）
EMBED_BACKEND=local
# 中文语料实测：bge-small-zh-v1.5 top-1 命中率 100%，
# 而通用英文模型 nomic-embed-text 只有 57%，所以中文场景用这个。
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 检索不到资料时直接拒答，而不是让模型自由发挥
RAG_REFUSE_WHEN_EMPTY=true

CORS_ORIGINS=*

