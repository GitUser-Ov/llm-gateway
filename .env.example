APP_NAME=campus-ai
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

DEEPSEEK_API_KEY=sk-你自己的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
LLM_FALLBACK_MESSAGE=抱歉，模型服务暂时不可用，请稍后重试
LLM_STREAM_USAGE=true

# 多上游网关：JSON 数组，顺序即优先级，第一个是主上游，失败自动切换下一个。
# 留空则回退到上面 DEEPSEEK_* 的单上游配置（向后兼容）。
# 例：
# LLM_UPSTREAMS=[{"name":"deepseek","api_key":"sk-xxx","model":"deepseek-chat"},{"name":"doubao","api_key":"ark-xxx","base_url":"https://ark.cn-beijing.volces.com/api/v3","model":"doubao-xxx"}]
LLM_UPSTREAMS=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

DATABASE_URL=postgresql+psycopg://campus:campus_pwd@localhost:5432/campus
REDIS_URL=redis://localhost:6379/0
ANSWER_CACHE_TTL=3600

RATE_LIMIT_PER_MINUTE=20
DAILY_QUOTA=300

CORS_ORIGINS=*

